#!/usr/local/bin/Rscript
library(tidyverse)
library(magrittr)
library(httr)
setwd("/Users/s.munzert/Documents/github/intro-to-data-science-26/lectures/03_iteration/examples/cronR")
url <- "http://www.spiegel.de/schlagzeilen/"
url_out <- GET(url, add_headers(from = "eddie@datacollection.com"))
datetime <- str_replace_all(Sys.time(), "[ :]", "-")
content(url_out, as = "text") %>% write(file = str_c("spiegelHeadlines/spon-", datetime, ".html"))
datetime <- str_replace_all(Sys.time(), "[ :]", "-")
content(url_out, as = "text") %>% write(file = str_c("spiegelHeadlines/spon-", datetime, ".html"))
library(cronR)
myscript <- "spiegel_scraper.R"
# Create bash code for crontab to execute R script
cmd <- cron_rscript(myscript)
## Run every minute
cron_add(command = cmd, frequency = 'minutely',
id = 'ScraperR_1min', description = 'Spiegel every 1min')
## Check number of running cronR jobs
cron_njobs()
## Check cronR jobs
cron_ls()
