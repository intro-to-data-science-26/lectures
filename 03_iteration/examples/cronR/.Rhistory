# blackjack.R
# Play one round of blackjack against the dealer in the R console.
#
# Usage:
#   source("blackjack.R")
#   play_blackjack()            # interactive: type "h" to hit, "s" to stand
#   play_blackjack(seed = 42)   # reproducible deal
#
# Rules: single 52-card deck, dealer stands on all 17s (incl. soft 17),
# blackjack (ace + ten-value card) beats a regular 21. No splits/doubles.
RANKS <- c("A", 2:10, "J", "Q", "K")
SUITS <- c("\u2660", "\u2665", "\u2666", "\u2663")  # spades, hearts, diamonds, clubs
# Cards are stored as integers 1:52; these helpers map them to rank/suit.
rank_of <- function(cards) RANKS[(cards - 1) %% 13 + 1]
suit_of <- function(cards) SUITS[(cards - 1) %/% 13 + 1]
card_label <- function(cards) paste0(rank_of(cards), suit_of(cards))
hand_value <- function(hand) {
# hand: character vector of ranks, e.g. c("A", "10", "7")
vals <- ifelse(hand == "A", 11L,
ifelse(hand %in% c("J", "Q", "K"), 10L, suppressWarnings(as.integer(hand))))
total <- sum(vals)
n_aces <- sum(hand == "A")
# count aces as 1 instead of 11 while we're bust
while (total > 21 && n_aces > 0) {
total <- total - 10L
n_aces <- n_aces - 1L
}
total
}
format_hand <- function(cards) {
sprintf("%s  (total: %d)", paste(card_label(cards), collapse = " "), hand_value(rank_of(cards)))
}
play_blackjack <- function(seed = NULL) {
if (!is.null(seed)) set.seed(seed)
# --- build and shuffle deck --------------------------------------------
deck <- sample(52)
draw <- function(n = 1) {
cards <- deck[seq_len(n)]
deck <<- deck[-seq_len(n)]
cards
}
# --- initial deal ------------------------------------------------------
player <- draw(2)
dealer <- draw(2)
cat("\n=== Blackjack ===\n")
cat("Dealer shows: ", card_label(dealer[1]), " [hidden]\n", sep = "")
cat("Your hand:    ", format_hand(player), "\n\n", sep = "")
player_bj <- hand_value(rank_of(player)) == 21
dealer_bj <- hand_value(rank_of(dealer)) == 21
if (player_bj || dealer_bj) {
cat("Dealer reveals: ", format_hand(dealer), "\n", sep = "")
result <- if (player_bj && dealer_bj) "push" else if (player_bj) "win" else "lose"
msg <- switch(result,
push = "Both have blackjack. Push.",
win  = "Blackjack! You win.",
lose = "Dealer has blackjack. You lose.")
cat(msg, "\n\n")
return(invisible(list(result = result, player = card_label(player), dealer = card_label(dealer))))
}
# --- player's turn -----------------------------------------------------
repeat {
if (!interactive()) {
cat("(Non-interactive session: standing automatically.)\n")
break
}
ans <- tolower(trimws(readline("Hit or stand? [h/s]: ")))
if (ans %in% c("s", "stand")) break
if (!ans %in% c("h", "hit")) {
cat("Please type h (hit) or s (stand).\n")
next
}
player <- c(player, draw())
cat("Your hand:    ", format_hand(player), "\n", sep = "")
if (hand_value(rank_of(player)) > 21) {
cat("\nBust! You lose.\n\n")
return(invisible(list(result = "lose", player = card_label(player), dealer = card_label(dealer))))
}
if (hand_value(rank_of(player)) == 21) {
cat("21 - standing.\n")
break
}
}
# --- dealer's turn -----------------------------------------------------
cat("\nDealer reveals: ", format_hand(dealer), "\n", sep = "")
while (hand_value(rank_of(dealer)) < 17) {
dealer <- c(dealer, draw())
cat("Dealer draws:   ", format_hand(dealer), "\n", sep = "")
}
# --- settle ------------------------------------------------------------
p <- hand_value(rank_of(player))
d <- hand_value(rank_of(dealer))
result <- if (d > 21) "win" else if (p > d) "win" else if (p < d) "lose" else "push"
msg <- switch(result,
win  = if (d > 21) "Dealer busts. You win!" else sprintf("You win, %d to %d.", p, d),
lose = sprintf("You lose, %d to %d.", p, d),
push = sprintf("Push at %d.", p))
cat("\n", msg, "\n\n", sep = "")
invisible(list(result = result, player = card_label(player), dealer = card_label(dealer)))
}
play_blackjack()
play_blackjack()
play_blackjack()
