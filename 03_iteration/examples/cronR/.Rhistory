temp_convert <-
function(temp, from = "f") {
if (!(from %in% c("f", "c"))){
stop("No valid input
temperature specified.")
}
if (from == "f") {
out <- (temp - 32) * (5/9)
} else {
out <- temp * (9/5) + 32
}
if((from == "c" & temp > 30) |
(from == "f" & out > 30)) {
message("That's damn hot!")
}else{
message("That's not so hot.")
}
return(out) # return temperature
}
temp_convert(100, from = "k")
